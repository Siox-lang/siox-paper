<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  siox in the One Dark Pro palette, combining how it colours Rust and VHDL
  (scopes from siox.sublime-syntax). siox takes its program structure from
  Rust and its hardware model from VHDL, and each part keeps its colours:

  from Rust   keywords purple · user types and generics yellow · functions,
              macros and directives blue · variables red · numbers orange ·
              strings green · operators cyan · comments grey italic
  from VHDL   built-in hardware types (Bit, Logic, unsigned, time ...) cyan,
              as std_logic and unsigned are · unit suffixes and radix prefixes
              cyan with them · tick attributes ('event, 'old, 'length) orange
              italic · logic literals ('0', 'Z') green · entity and process
              purple · port directions and views pink
  labels      grey, so they never read as keywords

    background #282c34  foreground #abb2bf  comment #7f848e  label #828997
    purple #c678dd  blue #61afef  cyan #56b6c2  yellow #e5c07b
    green #98c379  orange #d19a66  red #e06c75  pink #e5a0c6
-->
<plist version="1.0">
<dict>
  <key>name</key><string>siox One Dark Pro</string>
  <key>settings</key>
  <array>
    <dict><key>settings</key><dict>
      <key>background</key><string>#282c34</string>
      <key>foreground</key><string>#abb2bf</string>
    </dict></dict>

    <dict><key>name</key><string>Comments</string>
      <key>scope</key><string>comment</string>
      <key>settings</key><dict><key>foreground</key><string>#7f848e</string><key>fontStyle</key><string>italic</string></dict></dict>

    <dict><key>name</key><string>Keywords</string>
      <key>scope</key><string>keyword.declaration, keyword.control, keyword.operator.word</string>
      <key>settings</key><dict><key>foreground</key><string>#c678dd</string></dict></dict>
    <dict><key>name</key><string>directions and views</string>
      <key>scope</key><string>storage.modifier.direction</string>
      <key>settings</key><dict><key>foreground</key><string>#e5a0c6</string></dict></dict>

    <dict><key>name</key><string>Labels: grey, so they never read as keywords</string>
      <key>scope</key><string>entity.name.label</string>
      <key>settings</key><dict><key>foreground</key><string>#828997</string></dict></dict>

    <dict><key>name</key><string>Tick attributes (VHDL attribute names)</string>
      <key>scope</key><string>entity.other.attribute-name, punctuation.accessor.tick, variable.language.stage</string>
      <key>settings</key><dict><key>foreground</key><string>#d19a66</string><key>fontStyle</key><string>italic</string></dict></dict>

    <dict><key>name</key><string>Built-in hardware types, unit suffixes, radix prefixes (VHDL std types)</string>
      <key>scope</key><string>storage.type.builtin, storage.type.numeric.suffix, storage.modifier.radix</string>
      <key>settings</key><dict><key>foreground</key><string>#56b6c2</string></dict></dict>

    <dict><key>name</key><string>User types and generic parameters (Rust types)</string>
      <key>scope</key><string>entity.name.type</string>
      <key>settings</key><dict><key>foreground</key><string>#e5c07b</string></dict></dict>

    <dict><key>name</key><string>Modules in paths</string>
      <key>scope</key><string>entity.name.namespace</string>
      <key>settings</key><dict><key>foreground</key><string>#e5c07b</string></dict></dict>

    <dict><key>name</key><string>Functions, methods and macros</string>
      <key>scope</key><string>entity.name.function, variable.function, support.function.macro, punctuation.definition.macro</string>
      <key>settings</key><dict><key>foreground</key><string>#61afef</string></dict></dict>

    <dict><key>name</key><string>Directives (Rust attributes)</string>
      <key>scope</key><string>meta.annotation, punctuation.definition.annotation</string>
      <key>settings</key><dict><key>foreground</key><string>#abb2bf</string></dict></dict>
    <dict><key>name</key><string>Directive names</string>
      <key>scope</key><string>keyword.other.directive</string>
      <key>settings</key><dict><key>foreground</key><string>#61afef</string></dict></dict>
    <dict><key>name</key><string>Directive arguments</string>
      <key>scope</key><string>variable.annotation</string>
      <key>settings</key><dict><key>foreground</key><string>#e5c07b</string></dict></dict>

    <dict><key>name</key><string>Variables, fields, ports</string>
      <key>scope</key><string>variable.other</string>
      <key>settings</key><dict><key>foreground</key><string>#e06c75</string></dict></dict>

    <dict><key>name</key><string>self</string>
      <key>scope</key><string>variable.language.self</string>
      <key>settings</key><dict><key>foreground</key><string>#e06c75</string><key>fontStyle</key><string>italic</string></dict></dict>

    <dict><key>name</key><string>Numbers and constants</string>
      <key>scope</key><string>constant.numeric, constant.language, variable.other.constant</string>
      <key>settings</key><dict><key>foreground</key><string>#d19a66</string></dict></dict>

    <dict><key>name</key><string>Characters and strings</string>
      <key>scope</key><string>constant.character, string</string>
      <key>settings</key><dict><key>foreground</key><string>#98c379</string></dict></dict>

    <dict><key>name</key><string>Escapes and placeholders</string>
      <key>scope</key><string>constant.character.escape, constant.other.placeholder</string>
      <key>settings</key><dict><key>foreground</key><string>#56b6c2</string></dict></dict>

    <dict><key>name</key><string>Operators</string>
      <key>scope</key><string>keyword.operator</string>
      <key>settings</key><dict><key>foreground</key><string>#56b6c2</string></dict></dict>

    <dict><key>name</key><string>Punctuation</string>
      <key>scope</key><string>punctuation.accessor.path, punctuation.separator</string>
      <key>settings</key><dict><key>foreground</key><string>#abb2bf</string></dict></dict>
  </array>
</dict>
</plist>
