<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  siox in the One Dark Pro palette (scopes from siox.sublime-syntax).
  Keywords, built-in data types, user types, labels, attributes and literals
  each keep their own colour, so `entity`, `Bit` and `Counter` never look
  alike, and literal prefixes and suffixes are never red.

    background #282c34   foreground #abb2bf   comment #7f848e
    purple     #c678dd   blue       #61afef   cyan    #56b6c2
    yellow     #e5c07b   green      #98c379   orange  #d19a66
    red        #e06c75
-->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>siox One Dark Pro</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#282c34</string>
        <key>foreground</key><string>#abb2bf</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Comments</string>
      <key>scope</key><string>comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#7f848e</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Keywords</string>
      <key>scope</key><string>keyword.declaration, keyword.control, keyword.operator.word, storage.modifier.direction</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c678dd</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Directives</string>
      <key>scope</key><string>keyword.other.directive, variable.annotation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#c678dd</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Directive brackets</string>
      <key>scope</key><string>punctuation.definition.annotation</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#abb2bf</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Built-in data types</string>
      <key>scope</key><string>storage.type.builtin</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#56b6c2</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>User types</string>
      <key>scope</key><string>entity.name.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e5c07b</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Functions and methods</string>
      <key>scope</key><string>entity.name.function, variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#61afef</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Macros</string>
      <key>scope</key><string>support.function.macro, punctuation.definition.macro</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#61afef</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Labels</string>
      <key>scope</key><string>entity.name.label</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e06c75</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Tick attributes</string>
      <key>scope</key><string>entity.other.attribute-name, punctuation.accessor.tick</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e06c75</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Numbers and constants</string>
      <key>scope</key><string>constant.numeric, constant.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#d19a66</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Literal suffixes and radix prefixes</string>
      <key>scope</key><string>storage.type.numeric.suffix, storage.modifier.radix</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#56b6c2</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Characters and strings</string>
      <key>scope</key><string>constant.character, string</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#98c379</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Escapes and placeholders</string>
      <key>scope</key><string>constant.character.escape, constant.other.placeholder</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#56b6c2</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>self</string>
      <key>scope</key><string>variable.language</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#e06c75</string>
        <key>fontStyle</key><string>italic</string>
      </dict>
    </dict>

    <dict>
      <key>name</key><string>Operators and punctuation</string>
      <key>scope</key><string>keyword.operator, punctuation.accessor.path, punctuation.separator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key><string>#abb2bf</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
